        "bg": {
          "$value": "#171A20"
        },
        "border": {
          "$value": "#313642"
        },
        "headerBg": {
          "$value": "#1F232A"
        },
        "headerText": {
          "$value": "#E9EAEF"
        },
        "headerSub": {
          "$value": "#A0A6B4"
        }
      }
    },
    "halo": {
      "$type": "color",
