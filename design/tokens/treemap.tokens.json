      "pending": {
        "$value": "#3A3F4C"
      },
      "shared": {
        "$value": "#5A5F6B"
      },
      "share": {
        "1": {
          "$value": "#4A2445",
          "$description": "多余的副本 > 0"
        },
        "2": {
          "$value": "#7A2F70",
          "$description": "≥ 10 %"
        },
        "3": {
          "$value": "#96338B",
          "$description": "≥ 40 %"
        },
        "4": {
          "$value": "#F28CE2",
          "$description": "≥ 80 %，也是多余副本这个文件本身"
        }
      },
      "keepRim": {
        "$value": "#F28CE2",
        "$description": "保留的一份：1.5 px 内描边"
      },
      "text": {
        "$value": "#F28CE2",
