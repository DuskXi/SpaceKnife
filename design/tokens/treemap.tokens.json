          "$value": "#0C0E12"
        },
        "border": {
          "$value": "#22262F"
        },
        "headerBg": {
          "$value": "#13151B"
        },
        "headerText": {
          "$value": "#F1F2F5"
        },
        "headerSub": {
          "$value": "#9AA0AE"
        }
      },
      "1": {
        "bg": {
          "$value": "#101217"
        },
        "border": {
          "$value": "#272B35"
        },
        "headerBg": {
          "$value": "#171A20"
        },
        "headerText": {
          "$value": "#EEEFF3"
        },
        "headerSub": {
          "$value": "#9AA0AE"
        }
      },
      "2": {
        "bg": {
          "$value": "#13161B"
        },
        "border": {
          "$value": "#2C303B"
        },
        "headerBg": {
          "$value": "#1B1E25"
        },
        "headerText": {
          "$value": "#ECEDF1"
