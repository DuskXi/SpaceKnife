{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceKnife",
  "mainBinaryName": "spaceknife",
  "version": "0.3.5",
  "identifier": "io.github.duskxi.spaceknife",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:*",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data:"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DuskXi",
    "copyright": "Copyright © DuskXi. MIT License.",
    "homepage": "https://github.com/DuskXi/SpaceKnife",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "See what fills your drives",
    "longDescription": "SpaceKnife scans drives and folders and shows what fills them: a treemap and other views, filters, comparisons, snapshots.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
