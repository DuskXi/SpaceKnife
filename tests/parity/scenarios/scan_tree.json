{
  "name": "scan_tree",
  "description": "Scan a known tree in-process, read it back (status, list, node, children, find, summary, path forms), save and load a snapshot, rescan a folder after a change, close, and the errors of unknown scans, nodes and paths.",
  "fixtures": {"tree": "standard", "small": "small"},
  "known_diffs": [
    {"path": "steps/12/result/items/**", "why": "tree.children sort=name: Rust sorts A→Z, 0.3.4 Z→A (store.sorted_children descending by default). The interface does not call tree.children."},
    {"path": "steps/15/result/items/**", "why": "the same name order, one page"},
    {"path": "steps/*/wait_scan/monitor/**", "bug": "scan-topic-silent-monitor", "why": "Rust: monitor=null in the final status of a scan (see monitor.json)"},
    {"path": "steps/3/result/monitor/**", "bug": "scan-topic-silent-monitor", "why": "scan.status right after the scan, the same"},
    {"path": "steps/4/result/scans/0/monitor/**", "bug": "scan-topic-silent-monitor", "why": "scan.list right after the scan, the same"},
    {"path": "steps/48/wait_scan/io", "why": "a pooled scan's final status: Rust keeps the I/O governor state, 0.3.4 clears it (the details panel can then show the load section of a finished scan)"},
    {"path": "steps/*/result/node/ctime", "bug": "linux-root-ctime", "why": "Linux: the scan root's creation time comes from std's created() (statx birth time) while every other entry has none, as in 0.3.4 (sk-core scan/scanner.rs root Times; sk-native st_birth is 0 on Linux)"},
    {"path": "steps/*/result/parent/ctime", "bug": "linux-root-ctime", "why": "the same root, as a parent"}
  ],
  "steps": [
    {"call": "scan.check_paths", "params": {"paths": ["$ROOT/tree", "$ROOT/tree/a", "$ROOT/small", "$ROOT/nope", "$ROOT/tree/c.txt", "relative/path", ""]}},
    {"call": "scan.start", "params": {"roots": ["$ROOT/tree"], "workers": 0, "auto_snapshot": false}, "as": "s", "pick": ["roots", "source"]},
    {"wait_scan": "$s.scan_id", "as": "done"},
    {"call": "scan.status", "params": {"scan_id": "$s.scan_id"}},
    {"call": "scan.list", "params": {}},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree"}, "as": "top"},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a"}, "as": "a"},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/中文 文件夹/照片.jpg"}},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/missing"}},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/elsewhere"}},
    {"call": "tree.node", "params": {"scan_id": "$s.scan_id", "node": "$a.node.id"}},
    {"call": "tree.children", "params": {"scan_id": "$s.scan_id", "node": "$top.node.id"}},
    {"call": "tree.children", "params": {"scan_id": "$s.scan_id", "node": "$top.node.id", "sort": "name"}},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/many"}, "as": "many"},
    {"call": "tree.children", "params": {"scan_id": "$s.scan_id", "node": "$many.node.id", "offset": 290, "limit": 5}},
    {"call": "tree.children", "params": {"scan_id": "$s.scan_id", "node": "$many.node.id", "sort": "name", "offset": 0, "limit": 3}},
    {"call": "tree.children", "params": {"scan_id": "$s.scan_id", "node": "$many.node.id", "offset": 400}},
    {"call": "tree.summary", "params": {"scan_id": "$s.scan_id", "node": "$top.node.id"}},
    {"call": "tree.summary", "params": {"scan_id": "$s.scan_id", "node": "$a.node.id", "top": 2}},
    {"call": "path.forms", "params": {"scan_id": "$s.scan_id", "node": "$a.node.id"}},
    {"call": "tree.node", "params": {"scan_id": "$s.scan_id", "node": 999999}},
    {"call": "tree.children", "params": {"scan_id": "$s.scan_id", "node": 999999}},
    {"call": "tree.node", "params": {"scan_id": "no-such-scan", "node": 0}},
    {"call": "scan.status", "params": {"scan_id": "no-such-scan"}},
    {"call": "scan.cancel", "params": {"scan_id": "$s.scan_id"}, "pick": ["state", "items", "files", "dirs"]},
    {"call": "scan.pause", "params": {"scan_id": "$s.scan_id"}, "pick": ["state", "paused"]},
    {"call": "scan.resume", "params": {"scan_id": "$s.scan_id"}, "pick": ["state", "paused"]},
    {"call": "scan.continue", "params": {"scan_id": "$s.scan_id"}},
    {"call": "scan.set_load", "params": {"scan_id": "$s.scan_id", "level": "quiet"}, "pick": ["state"]},
    {"call": "snapshot.save", "params": {"scan_id": "$s.scan_id", "path": "$TMP/saved.sks"}, "omit": ["file_bytes"]},
    {"call": "snapshot.load", "params": {"path": "$TMP/saved.sks"}, "as": "loaded"},
    {"call": "tree.find", "params": {"scan_id": "$loaded.scan_id", "path": "$ROOT/tree/a/sub/movie.mp4"}},
    {"call": "snapshot.load", "params": {"path": "$TMP/not-there.sks"}},
    {"fs": {"op": "write", "path": "$TMP/garbage.sks", "size": 64}},
    {"call": "snapshot.load", "params": {"path": "$TMP/garbage.sks"}},
    {"call": "snapshot.list", "params": {}},
    {"fs": {"op": "write", "path": "$ROOT/tree/a/new.bin", "size": 4096}},
    {"fs": {"op": "remove", "path": "$ROOT/tree/a/one.bin"}},
    {"fs": {"op": "touch", "path": "$ROOT/tree/a"}},
    {"call": "scan.rescan", "params": {"scan_id": "$s.scan_id", "node": "$a.node.id"}, "pick": ["roots", "source"]},
    {"until": {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a/new.bin"}, "field": "node"}, "timeout": 30},
    {"until": {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a/one.bin"}, "field": "node", "null": true}, "timeout": 30},
    {"wait_scan": "$s.scan_id", "pick": ["state", "items", "files", "dirs", "bytes_size", "errors"]},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a"}, "as": "a2"},
    {"call": "tree.children", "params": {"scan_id": "$s.scan_id", "node": "$a2.node.id"}},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a/one.bin"}},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a/new.bin"}},
    {"call": "scan.start", "params": {"roots": ["$ROOT/small", "$ROOT/tree/b"], "workers": 2, "auto_snapshot": false}, "as": "two", "pick": ["roots"]},
    {"wait_scan": "$two.scan_id"},
    {"call": "tree.find", "params": {"scan_id": "$two.scan_id", "path": "$ROOT/small/b/c/three.mp4"}},
    {"call": "scan.close", "params": {"scan_id": "$two.scan_id"}},
    {"call": "scan.status", "params": {"scan_id": "$two.scan_id"}},
    {"call": "scan.start", "params": {"roots": ["$ROOT/nope"], "workers": 0, "auto_snapshot": false}},
    {"call": "scan.start", "params": {"roots": [], "workers": 0}},
    {"call": "scan.start", "params": {"roots": ["relative"], "workers": 0}},
    {"call": "scan.start", "params": {"roots": ["$ROOT/tree/c.txt"], "workers": 0}},
    {"call": "scan.close", "params": {"scan_id": "$loaded.scan_id"}},
    {"call": "scan.list", "params": {}}
  ]
}
