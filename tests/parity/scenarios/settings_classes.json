{
  "name": "settings_classes",
  "description": "Settings (get, update with versions and conflicts, invalid values, reset by page, export and import, settings.changed to every session in order) and file classes (get, update, folder classes, reset, classes.changed), and that both survive a restart.",
  "fixtures": {"small": "small"},
  "known_diffs": [
    {"path": "**/meta/45/description", "why": "scan.workers: the Rust text drops 0.3.4's mention of worker processes without the native extension (there is no Python fallback any more)"}
  ],
  "steps": [
    {"connect": "other"},
    {"call": "settings.get", "params": {}, "as": "s0"},
    {"call": "settings.update", "params": {"values": {"treemap.initial_detail": 7, "appearance.theme": "dark", "tags.name_red": "Delete me"}, "version": "$s0.version"}, "as": "s1", "pick": ["version", "values"]},
    {"events": "settings.changed", "count": 1, "pick": ["state"], "on": "other"},
    {"call": "settings.update", "params": {"values": {"treemap.initial_detail": 8}, "version": "$s0.version"}},
    {"call": "settings.update", "params": {"values": {"treemap.initial_detail": 99}, "version": "$s1.version"}},
    {"call": "settings.update", "params": {"values": {"no.such_setting": 1}, "version": "$s1.version"}},
    {"call": "settings.update", "params": {"values": {"appearance.theme": "purple"}}},
    {"call": "settings.update", "params": {"values": {"general.update_channel": "stable", "scan.unit_base": "1000"}}, "pick": ["version", "values"]},
    {"events": "settings.changed", "count": 1, "pick": ["state"], "on": "other"},
    {"call": "settings.reset", "params": {"category": "treemap"}, "pick": ["version", "values"]},
    {"events": "settings.changed", "count": 1, "pick": ["state"], "on": "other"},
    {"call": "settings.reset", "params": {"category": "nonsense"}},
    {"call": "settings.export", "params": {"path": "$TMP/exported.json"}},
    {"call": "settings.reset", "params": {}, "pick": ["version", "values"]},
    {"call": "settings.import", "params": {"path": "$TMP/exported.json"}},
    {"call": "settings.import", "params": {"path": "$TMP/exported.json", "apply": true}},
    {"call": "settings.import", "params": {"path": "$TMP/missing.json"}},
    {"fs": {"op": "write", "path": "$TMP/garbage.json", "size": 10}},
    {"call": "settings.import", "params": {"path": "$TMP/garbage.json"}},
    {"call": "settings.get", "params": {}, "pick": ["version", "values"]},
    {"drain": "settings.changed", "on": "other"},
    {"call": "classes.get", "params": {}, "as": "c0"},
    {"call": "classes.update", "params": {"classes": [{"id": "image", "name": "Pictures", "color": "#ff0000", "color_light": "#aa0000", "extensions": ["jpg", "png"]}, {"name": "Logs", "color": "#00ff00", "extensions": ["log", "txt"]}, {"id": "other", "name": "Other"}]}},
    {"events": "classes.changed", "count": 1, "on": "other"},
    {"call": "classes.update", "params": {"classes": [{"name": "", "extensions": ["x"]}]}},
    {"call": "classes.update", "params": {"classes": [{"name": "Bad", "color": "not a colour"}]}},
    {"call": "classes.folder", "params": {"path": "$ROOT/small/a", "class_id": "image"}},
    {"events": "classes.changed", "count": 1, "on": "other"},
    {"call": "classes.folder", "params": {"path": "$ROOT/small/b", "class_id": "no-such-class"}},
    {"call": "filter.vocab", "params": {}},
    {"restart": true},
    {"call": "settings.get", "params": {}, "pick": ["values"]},
    {"call": "classes.get", "params": {}},
    {"call": "classes.folder", "params": {"path": "$ROOT/small/a"}},
    {"call": "classes.reset", "params": {}},
    {"call": "classes.get", "params": {}},
    {"call": "filter.vocab", "params": {}}
  ]
}
