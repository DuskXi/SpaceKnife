{
  "name": "views",
  "description": "Views on a finished scan with their binary frames decoded (header, columns, node ids as paths): open, render, zoom/back/forward/up/home, select, settings and the three visualizations, filter, results, reveal, tags, close; frames of the treemap, the flame graph and the polar flame graph.",
  "fixtures": {"tree": "standard"},
  "steps": [
    {"call": "scan.start", "params": {"roots": ["$ROOT/tree"], "workers": 0, "auto_snapshot": false}, "as": "s", "record": false},
    {"wait_scan": "$s.scan_id", "pick": ["state", "items"]},
    {"call": "visual.list", "params": {}},
    {"call": "view.open", "params": {"scan_id": "$s.scan_id", "viewport": {"width": 800, "height": 600, "dpr": 1}}, "as": "v", "binary": true},
    {"call": "view.render", "params": {"view_id": "$v.state.view_id"}, "binary": true},
    {"call": "view.list", "params": {}},
    {"call": "view.list", "params": {"scan_id": "$s.scan_id"}},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a"}, "as": "a", "record": false},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/many/f150.log"}, "as": "f150", "record": false},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/deep/l1/l2/l3/l4/x.dat"}, "as": "x", "record": false},
    {"call": "view.zoom", "params": {"view_id": "$v.state.view_id", "key": "$a.node.id"}, "binary": true},
    {"call": "view.back", "params": {"view_id": "$v.state.view_id"}, "binary": true},
    {"call": "view.forward", "params": {"view_id": "$v.state.view_id"}, "binary": true},
    {"call": "view.up", "params": {"view_id": "$v.state.view_id"}, "binary": true},
    {"call": "view.up", "params": {"view_id": "$v.state.view_id"}},
    {"call": "view.home", "params": {"view_id": "$v.state.view_id"}, "binary": true},
    {"call": "view.select", "params": {"view_id": "$v.state.view_id", "key": "$a.node.id"}, "binary": true},
    {"call": "view.select", "params": {"view_id": "$v.state.view_id"}, "binary": true},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"detail": 2}}, "binary": true},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"detail": 15, "min_element": 2}}, "binary": true},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"detail": 99}}},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"color_mode": "time"}}, "binary": true},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"color_mode": "branch", "sort_by_size": false}}, "binary": true},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"visual": "flame"}}, "binary": true},
    {"call": "view.zoom", "params": {"view_id": "$v.state.view_id", "key": "$a.node.id"}, "binary": true},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"visual": "flame_polar", "detail": 5}}, "binary": true},
    {"call": "view.home", "params": {"view_id": "$v.state.view_id"}, "binary": true},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"visual": "no-such-visual"}}},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"visual": "treemap", "color_mode": "class", "sort_by_size": true, "viewport": {"width": 400, "height": 300, "dpr": 2}}}, "binary": true},
    {"call": "view.filter", "params": {"view_id": "$v.state.view_id", "text": "*.log"}, "binary": true},
    {"call": "view.results", "params": {"view_id": "$v.state.view_id"}},
    {"call": "view.results", "params": {"view_id": "$v.state.view_id", "sort": "name", "limit": 5, "offset": 1}},
    {"call": "view.filter", "params": {"view_id": "$v.state.view_id", "text": ">1kb;<10kb"}, "binary": true},
    {"call": "view.results", "params": {"view_id": "$v.state.view_id", "sort": "count"}},
    {"call": "view.filter", "params": {"view_id": "$v.state.view_id", "text": ">>1kb"}},
    {"call": "view.set", "params": {"view_id": "$v.state.view_id", "settings": {"filter_mode": "hide"}}, "binary": true},
    {"call": "view.filter", "params": {"view_id": "$v.state.view_id", "text": ""}, "binary": true},
    {"call": "view.reveal", "params": {"view_id": "$v.state.view_id", "key": "$f150.node.id"}, "binary": true},
    {"call": "view.reveal", "params": {"view_id": "$v.state.view_id", "key": "$x.node.id"}, "binary": true},
    {"call": "view.home", "params": {"view_id": "$v.state.view_id"}, "record": false},
    {"call": "view.select", "params": {"view_id": "$v.state.view_id", "key": "$a.node.id"}, "record": false},
    {"call": "view.tag", "params": {"view_id": "$v.state.view_id", "color": "red"}, "binary": true},
    {"call": "tree.summary", "params": {"scan_id": "$s.scan_id", "node": "$a.node.id"}, "pick": ["tag"]},
    {"call": "view.tag", "params": {"view_id": "$v.state.view_id"}, "binary": true},
    {"call": "view.zoom", "params": {"view_id": "$v.state.view_id", "key": 999999}},
    {"call": "view.open", "params": {"scan_id": "$s.scan_id", "viewport": {"width": 300, "height": 300}, "settings": {"visual": "flame_polar", "color_mode": "flat"}}, "as": "p", "binary": true},
    {"call": "view.close", "params": {"view_id": "$p.state.view_id"}},
    {"call": "view.render", "params": {"view_id": "$p.state.view_id"}},
    {"call": "view.open", "params": {"scan_id": "no-such-scan", "viewport": {"width": 300, "height": 300}}},
    {"connect": "old", "capabilities": ["binary-frames.v1", "subscriptions"]},
    {"call": "view.open", "params": {"scan_id": "$s.scan_id", "viewport": {"width": 200, "height": 100}, "settings": {"visual": "flame"}}, "as": "o", "binary": true, "on": "old"},
    {"call": "view.set", "params": {"view_id": "$o.state.view_id", "settings": {"visual": "flame"}}, "on": "old"},
    {"call": "view.set", "params": {"view_id": "$o.state.view_id", "settings": {"color_mode": "branch"}}, "on": "old"},
    {"call": "view.render", "params": {"view_id": "$v.state.view_id"}, "on": "old"},
    {"call": "scan.close", "params": {"scan_id": "$s.scan_id"}},
    {"call": "view.render", "params": {"view_id": "$v.state.view_id"}},
    {"call": "view.list", "params": {}}
  ]
}
