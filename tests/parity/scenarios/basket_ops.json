{
  "name": "basket_ops",
  "description": "The delete basket shared by every session (add, folders absorbing their items, remove, clear, basket.changed in order) and a permanent deletion of fixture files: its undo window, undo, then the deletion done, with ops.progress in order.",
  "fixtures": {"tree": "small"},
  "normalize": {"drop_in": {"volumes": ["total", "trash_note"]}},
  "comment": "basket.changed is compared as the state the other session ends up with (mode latest after a settle): both backends re-send it after their background lock checks, at times that vary, and on Linux the Rust backend re-sends an unchanged basket",
  "steps": [
    {"connect": "other"},
    {"call": "basket.list", "params": {}},
    {"call": "scan.start", "params": {"roots": ["$ROOT/tree"], "workers": 0, "auto_snapshot": false}, "as": "s", "record": false},
    {"wait_scan": "$s.scan_id", "pick": ["state"]},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a/one.txt"}, "as": "one", "record": false},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/a"}, "as": "a", "record": false},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/top.bin"}, "as": "top", "record": false},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/b/c/three.mp4"}, "as": "three", "record": false},
    {"call": "basket.add", "params": {"scan_id": "$s.scan_id", "nodes": ["$one.node.id"]}},
    {"events": "basket.changed", "count": 1, "on": "other", "mode": "latest", "settle": 0.8},
    {"call": "basket.add", "params": {"scan_id": "$s.scan_id", "nodes": ["$a.node.id", "$top.node.id"]}},
    {"events": "basket.changed", "count": 1, "on": "other", "mode": "latest", "settle": 0.8},
    {"call": "basket.add", "params": {"scan_id": "$s.scan_id", "nodes": ["$one.node.id"]}},
    {"call": "basket.add", "params": {"scan_id": "$s.scan_id", "nodes": [999999]}},
    {"call": "basket.add", "params": {"scan_id": "no-such-scan", "nodes": [1]}},
    {"call": "basket.list", "params": {}, "as": "b"},
    {"call": "basket.remove", "params": {"ids": ["$b.items.1.id"]}},
    {"events": "basket.changed", "count": 1, "on": "other", "mode": "latest", "settle": 0.8},
    {"call": "basket.remove", "params": {"ids": ["no-such-item"]}},
    {"call": "basket.clear", "params": {}},
    {"events": "basket.changed", "count": 1, "on": "other", "mode": "latest", "settle": 0.8},
    {"call": "basket.add", "params": {"scan_id": "$s.scan_id", "nodes": ["$three.node.id", "$top.node.id"]}, "record": false},
    {"drain": "basket.changed", "on": "other", "settle": 0.5},
    {"call": "basket.execute", "params": {"mode": "delete"}, "as": "op"},
    {"events": "ops.progress", "count": 1, "timeout": 10},
    {"call": "ops.undo", "params": {"task_id": "$op.task_id"}},
    {"events": "ops.progress", "count": 1, "timeout": 10},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/tree/top.bin"}, "pick": ["node"]},
    {"call": "basket.list", "params": {}},
    {"call": "basket.execute", "params": {"mode": "delete"}, "as": "op2"},
    {"events": "ops.progress", "count": 1, "timeout": 10},
    {"call": "ops.cancel", "params": {"task_id": "no-such-task"}},
    {"call": "ops.undo", "params": {"task_id": "no-such-task"}},
    {"call": "basket.execute", "params": {"mode": "shred"}},
    {"call": "basket.clear", "params": {}}
  ]
}
