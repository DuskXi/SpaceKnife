{
  "name": "monitor",
  "description": "Live file monitoring over the protocol: the monitor of a finished scan, files and folders created, deleted and renamed reach the tree, the scan topic tells the UI, switching scan.monitor off stops it.",
  "fixtures": {"small": "small"},
  "normalize": {"time_keys": ["mtime"]},
  "known_diffs": [
    {"path": "steps/1/wait_scan/monitor", "bug": "scan-topic-silent-monitor", "why": "Rust: the final status of a scan has monitor=null (the monitor is still starting); 0.3.4 reports it running. With the next bug the status bar then says live monitoring is off."},
    {"path": "steps/3/got/0/status/monitor", "bug": "scan-topic-silent-monitor", "why": "the same status, pushed when subscribing"},
    {"path": "steps/21/**", "bug": "scan-topic-silent-monitor", "why": "Rust never pushes scan.progress when the monitor applies changes (sk-server/src/monitors.rs ServerHooks::applied only flashes views); 0.3.4 does, and the interface reads the monitor state and counts only from these pushes (apps/desktop/app/state/actions.ts onScanStatus)."}
  ],
  "steps": [
    {"call": "scan.start", "params": {"roots": ["$ROOT/small"], "workers": 0, "auto_snapshot": false}, "as": "s", "pick": ["source"]},
    {"wait_scan": "$s.scan_id", "pick": ["state", "items", "monitor"]},
    {"subscribe": "scan", "params": {"scan_id": "$s.scan_id"}},
    {"events": "scan.progress", "count": 1, "pick": ["status"], "timeout": 10},
    {"sleep": 2},
    {"call": "scan.status", "params": {"scan_id": "$s.scan_id"}, "pick": ["state", "items", "monitor"]},
    {"drain": "scan.progress"},
    {"fs": {"op": "write", "path": "$ROOT/small/live.bin", "size": 7000}},
    {"until": {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/small/live.bin"}, "field": "node"}, "timeout": 20},
    {"fs": {"op": "remove", "path": "$ROOT/small/a/one.txt"}},
    {"until": {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/small/a/one.txt"}, "field": "node", "null": true}, "timeout": 20},
    {"fs": {"op": "rename", "path": "$ROOT/small/b", "to": "$ROOT/small/b2"}},
    {"until": {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/small/b2/c/three.mp4"}, "field": "node"}, "timeout": 20},
    {"until": {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/small/b"}, "field": "node", "null": true}, "timeout": 20},
    {"fs": {"op": "mkdir", "path": "$ROOT/small/new/deep"}},
    {"fs": {"op": "write", "path": "$ROOT/small/new/deep/x.txt", "size": 10}},
    {"until": {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/small/new/deep/x.txt"}, "field": "node"}, "timeout": 20},
    {"fs": {"op": "write", "path": "$ROOT/small/new/deep/later.txt", "size": 20}},
    {"until": {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/small/new/deep/later.txt"}, "field": "node"}, "timeout": 20},
    {"sleep": 1},
    {"call": "scan.status", "params": {"scan_id": "$s.scan_id"}, "pick": ["state", "items", "files", "dirs", "bytes_size", "monitor"]},
    {"events": "scan.progress", "count": 1, "mode": "latest", "timeout": 5, "pick": ["status"]},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/small"}, "as": "top", "record": false},
    {"call": "tree.children", "params": {"scan_id": "$s.scan_id", "node": "$top.node.id"}, "omit": ["parent"]},
    {"call": "settings.get", "params": {}, "as": "st", "record": false},
    {"call": "settings.update", "params": {"values": {"scan.monitor": false}, "version": "$st.version"}, "pick": ["version"]},
    {"sleep": 1},
    {"call": "scan.status", "params": {"scan_id": "$s.scan_id"}, "pick": ["monitor"]},
    {"fs": {"op": "write", "path": "$ROOT/small/after-off.bin", "size": 300}},
    {"sleep": 2},
    {"call": "tree.find", "params": {"scan_id": "$s.scan_id", "path": "$ROOT/small/after-off.bin"}},
    {"call": "settings.get", "params": {}, "as": "st2", "record": false},
    {"call": "settings.update", "params": {"values": {"scan.monitor": true}, "version": "$st2.version"}, "pick": ["version"]},
    {"until": {"call": "scan.status", "params": {"scan_id": "$s.scan_id"}, "field": "monitor.state", "equals": "running"}, "timeout": 20},
    {"call": "scan.status", "params": {"scan_id": "$s.scan_id"}, "pick": ["monitor"]}
  ]
}
