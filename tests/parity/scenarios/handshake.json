{
  "name": "handshake",
  "description": "The ready line, session.hello and its refusals (docs/protocol.md §1-2): wrong token, other major version, missing subprotocol, a first frame that is binary / not hello / not JSON, bad hello params, other paths, foreign origins, the hello timeout.",
  "args": ["--hello-timeout", "1"],
  "steps": [
    {"ready": true},
    {"hello": true},
    {"handshake": {"token": "wrong-token-0123456789abcdef"}},
    {"handshake": {"protocol": "2.0"}},
    {"handshake": {"protocol": "1.0"}},
    {"handshake": {"protocol": "1.9"}},
    {"handshake": {"protocol": "x"}},
    {"handshake": {"subprotocol": false}},
    {"handshake": {"send": "binary"}},
    {"handshake": {"send": "request"}},
    {"handshake": {"send": "garbage"}},
    {"handshake": {"send": "hello", "params": {"token": "parity-token-0123456789abcdef"}}},
    {"handshake": {"send": "hello", "params": {"token": "parity-token-0123456789abcdef", "protocol": "1.1", "client": {"name": "x", "version": "0", "kind": "test"}, "capabilities": [], "extra": 1}}},
    {"handshake": {"send": "nothing", "timeout": 8}},
    {"handshake": {"path": "/v2"}},
    {"handshake": {"path": "/"}},
    {"handshake": {"origin": "http://evil.example"}},
    {"handshake": {"origin": "app://spaceknife"}},
    {"handshake": {"capabilities": ["subscriptions", "made-up.v9"]}},
    {"call": "system.ping", "params": {"payload": "parity"}},
    {"call": "system.ping", "params": {}},
    {"sleep": 1, "note": "the raw connections above are gone before sessions are counted"},
    {"call": "system.info", "params": {}},
    {"call": "session.hello", "params": {"token": "parity-token-0123456789abcdef", "protocol": "1.1", "client": {"name": "again", "version": "0", "kind": "test"}, "capabilities": []}},
    {"connect": "old", "capabilities": ["subscriptions"]},
    {"call": "visual.list", "params": {}, "on": "old"},
    {"call": "system.info", "params": {}, "pick": ["sessions"]}
  ]
}
