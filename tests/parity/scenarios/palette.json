{
  "name": "palette",
  "description": "The command palette over a scan: commands, queries (empty, a command name, a path, a filter, pinyin), command checks, the path group, filter previews, recents remembered and cleared, path forms, and the tags of the start page after a restart.",
  "fixtures": {"tree": "standard"},
  "known_diffs": [
    {"path": "steps/0/result/commands/#len", "why": "0.3.6 by design (issue #26): one command more, view.toggle_hidden_folders (H); 0.3.7 two more, item.hide_folder and item.unhide_folder (the selected folder in or out of the list, UI-W5-52). They are the last, so every other command keeps its index"},
    {"path": "steps/7/result/commands/**", "why": "0.3.6 by design (issue #26): the new command 「显示/隐藏设置里列出的文件夹」 (Show/hide the folders listed in settings) matches \"fd\" (folders) and ranks third, so every result after it moves down one; 0.3.7's Hide this folder from the picture and Stop hiding this folder match it too (folder)"},
    {"path": "steps/11/result/commands/#len", "why": "0.3.7 by design (issue #26, UI-W5-52): the new command Hide this folder from the picture matches \"theme\" (t-h in this, e in folder, m in from, e in picture) and is listed after Cycle coloring, which keeps its place"}
  ],
  "steps": [
    {"call": "palette.commands", "params": {}},
    {"call": "palette.query", "params": {"context": {"tab": "start"}}},
    {"call": "scan.start", "params": {"roots": ["$ROOT/tree"], "workers": 0, "auto_snapshot": false}, "as": "s", "record": false},
    {"wait_scan": "$s.scan_id", "pick": ["state"]},
    {"call": "view.open", "params": {"scan_id": "$s.scan_id", "viewport": {"width": 800, "height": 600}}, "as": "v", "record": false},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}}},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}, "text": "zoom"}},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}, "text": "fd"}},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}, "text": "$ROOT/tree/a"}},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}, "text": "*.log;>200b"}},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}, "text": ">>bad"}},
    {"call": "palette.query", "params": {"context": {"tab": "settings"}, "text": "theme"}},
    {"call": "palette.check", "params": {"id": "view.zoom_out", "context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}}},
    {"call": "palette.check", "params": {"id": "basket.execute", "context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}}},
    {"call": "palette.check", "params": {"id": "no.such.command", "context": {"tab": "start"}}},
    {"call": "palette.paths", "params": {"scan_id": "$s.scan_id"}},
    {"call": "palette.paths", "params": {"scan_id": "$s.scan_id", "text": "15.lo", "limit": 5}},
    {"call": "palette.paths", "params": {"scan_id": "$s.scan_id", "text": "$ROOT/tree/a/"}},
    {"call": "palette.paths", "params": {"scan_id": "$s.scan_id", "text": "照片"}},
    {"call": "palette.preview", "params": {"scan_id": "$s.scan_id", "text": "*.log"}},
    {"call": "palette.preview", "params": {"scan_id": "$s.scan_id", "text": ">>bad"}},
    {"call": "palette.remember", "params": {"kind": "jump", "text": "$ROOT/tree/a/sub", "scan_id": "$s.scan_id"}},
    {"call": "palette.remember", "params": {"kind": "filter", "text": "*.log"}},
    {"call": "palette.remember", "params": {"kind": "filter", "text": "*.mp4"}},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s.scan_id", "view_id": "$v.state.view_id"}}, "pick": ["recent"]},
    {"restart": true},
    {"call": "scan.start", "params": {"roots": ["$ROOT/tree"], "workers": 0, "auto_snapshot": false}, "as": "s2", "record": false},
    {"wait_scan": "$s2.scan_id", "pick": ["state"]},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s2.scan_id"}}, "pick": ["recent"]},
    {"call": "palette.clear", "params": {"scan_id": "$s2.scan_id"}},
    {"call": "palette.query", "params": {"context": {"tab": "scan", "scan_id": "$s2.scan_id"}}, "pick": ["recent"]},
    {"call": "palette.paths", "params": {"scan_id": "no-such-scan"}}
  ]
}
